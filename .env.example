# Discord bot credentials
TOKEN=
CLIENT_ID=
GUILD_ID=

# HTTP server (GRDNConnect callback endpoint)
BOT_PUBLIC_URL=
HTTP_SECRET=
HTTP_PORT=3000
# Interface for the HTTP server. Leave unset: it defaults to 127.0.0.1 so only
# cloudflared (same machine) can reach it. Setting 0.0.0.0 exposes the VPS's
# public IP on this port and bypasses Cloudflare.
HTTP_BIND=127.0.0.1

# Steam link prompt channel
STEAM_LINK_CHANNEL_ID=

# Cloudflare Access service token for host -connect tunnels (leave blank until the Access lock is on)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

