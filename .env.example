# Discord bot credentials
TOKEN=
CLIENT_ID=
GUILD_ID=

# HTTP server (GRDNConnect callback endpoint)
BOT_PUBLIC_URL=
HTTP_SECRET=
HTTP_PORT=3000

# Steam link prompt channel
STEAM_LINK_CHANNEL_ID=

# Cloudflare Access service token for host -connect tunnels (leave blank until the Access lock is on)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Mod auto-sync beta (bot half). Uncomment to enable /synctest and the /mod-sync endpoint.
# MOD_SYNC_BETA=true

